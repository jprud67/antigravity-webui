[Unit]
Description=Antigravity WebUI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/antigravity-webui
Environment=PYTHONPATH=/root/antigravity-webui/backend
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/antigravity-webui/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
